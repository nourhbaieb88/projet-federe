# Cle API Google Maps - VERSION DE TEST
# ATTENTION: Cette cle est pour les tests uniquement.
# Elle peut ne pas fonctionner ou etre limitee.
# Pour un usage en production, obtenez votre propre cle API.

# URL de l'API backend
REACT_APP_API_URL=http://localhost:8000/api

# URL publique du frontend pour les liens d'emails
FRONTEND_BASE_URL=http://localhost:3000

# Envoi d'emails Django
# En local sans SMTP reel, laissez la valeur console ci-dessous.
# Pour un vrai envoi, remplacez par: django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=votre-adresse@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=CityReserve <votre-adresse@gmail.com>

# Cle de demonstration (remplacez par la votre)
REACT_APP_GOOGLE_MAPS_API_KEY=AIzaSyDUMMY_API_KEY_FOR_DEMO_PURPOSES_ONLY
